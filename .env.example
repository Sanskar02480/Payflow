# Copy this file to .env and edit. .env is gitignored — never commit real secrets.
# Docker Compose auto-loads .env when you run `docker compose up`.

# --- Postgres (used by Docker Compose) ---
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change-me-locally

# --- Spring Boot (mirrors Postgres above; used by mvn spring-boot:run) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payflow
DB_USER=payflow
DB_PASSWORD=change-me-locally

# --- JWT signing key (use 64+ random characters in production) ---
JWT_SECRET=replace-with-a-64-character-or-longer-random-string-for-hs256

# --- Optional overrides ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP=localhost:9092
